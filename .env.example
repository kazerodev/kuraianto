# ID de tu Google Sheet (lo ves en la URL del sheet)
# Ejemplo: https://docs.google.com/spreadsheets/d/ABC123.../edit → ABC123...
SPREADSHEET_ID=1lMwQ6pGOxyZWowWkGlD10FH5jMi_fQ28VGj-1IUrnqg

# Ruta al archivo JSON de credenciales del Service Account
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Nombre de la pestaña con los leads (tal como aparece en la hoja)
SHEET_TAB_NAME=NEGOCIOS ESPAÑA,NEGOCIOS BÉLGICA

# Pestaña destino para nuevos leads importados con find-new-leads.js
# Si no se define, usa la primera de SHEET_TAB_NAME
IMPORT_TARGET_TAB=NEGOCIOS ESPAÑA
